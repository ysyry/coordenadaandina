# Copiar a .env y ajustar si hace falta.
# El puerto es 5433 y no 5432 para no chocar con otros proyectos.
DATABASE_URL="postgres://areal:areal_local@localhost:5433/areal"

# No hay clave compartida: cada una entra con su cuenta. La primera se crea con
#   npm run usuaria -- alta correo "Nombre" "una clave larga"

# Opcional, sólo en producción: el origen público, para las cookies.
# ORIGIN="https://coordenadaandina.ar"
